# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — override if the default flash model name has moved on.
# Check aistudio.google.com for the current recommended fast/cheap vision model.
GEMINI_MODEL=gemini-3.6-flash

# Postgres connection string (Vercel Postgres / Neon / Supabase all work)
DATABASE_URL=

# Clerk (https://dashboard.clerk.com) -- both unset means dev-bypass mode:
# every visitor is "dev-user", no accounts, nothing to configure locally.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Monthly Plus price in cents -- one number, read by both the paywall copy
# and checkout. Optional; defaults to 499 ($4.99).
NEXT_PUBLIC_PLUS_PRICE_CENTS=499

# Stripe (https://dashboard.stripe.com) -- unset means billing routes explain
# they're not configured yet instead of erroring. STRIPE_PRICE_ID is the
# recurring monthly Price for "Mind the Fit Plus". STRIPE_WEBHOOK_SECRET
# comes from the webhook endpoint registered for /api/webhooks/stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Base URL used to build Stripe success/cancel/return redirects. Optional;
# defaults to the production domain, so set this locally to avoid bouncing
# local testing back to the live site.
NEXT_PUBLIC_APP_URL=
