# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — override if the default flash model name has moved on.
# Check aistudio.google.com for the current recommended fast/cheap vision model.
GEMINI_MODEL=gemini-3.6-flash

# Postgres connection string (Vercel Postgres / Neon / Supabase all work)
DATABASE_URL=

# Clerk (https://dashboard.clerk.com) -- both unset means dev-bypass mode:
# every visitor is "dev-user", no accounts, nothing to configure locally.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Monthly Plus price in cents -- one number, read by both the paywall copy
# and (once billing exists) checkout. Optional; defaults to 499 ($4.99).
NEXT_PUBLIC_PLUS_PRICE_CENTS=499
