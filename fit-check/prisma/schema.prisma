generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id                  String     @id // Clerk user id ("dev-user" in dev-bypass mode)
  bust                Float
  waist               Float
  hip                 Float
  height              Float?
  // Crotch-to-floor. Optional; the highest-leverage addition for pants-length
  // accuracy since leg-length-to-height varies more than torso proportions.
  inseam              Float?
  // High-shoulder-point to crotch. Optional "bonus" field -- combined with
  // inseam, replaces the population shoulder-height ratio with a personalized
  // one. See lib/fit.ts estimateGarmentLanding.
  shoulderToInseam    Float?
  plan                String     @default("free") // "free" | "paid"
  stripeCustomerId     String?
  stripeSubscriptionId String?
  // Rolling usage counter for the free tier -- checksUsedThisMonth only
  // means what it says while usageMonth matches the current "YYYY-MM";
  // otherwise it's stale from a prior month and reads as 0 (see lib/usage.ts).
  checksUsedThisMonth Int        @default(0)
  usageMonth          String     @default("")
  // Bearer token the browser extension sends instead of a Clerk session
  // cookie -- generated on demand from Settings, regenerating invalidates
  // any extension already connected with the old value.
  extensionToken      String?    @unique
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  checks              FitCheck[]

  @@index([stripeSubscriptionId])
}

model FitCheck {
  id            String   @id @default(cuid())
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id])
  brand         String?
  garmentType   String   @default("dress")
  sourceUrl     String?
  bust          Float?
  waist         Float?
  hip           Float?
  length        Float?
  // Bottoms only (pants/jeans/shorts). rise has no body-side equivalent to
  // compare against, so it's informational only, not part of `verdict`.
  rise          Float?
  inseam        Float?
  rawExtraction Json?
  verdict       Json?
  // Snapshot of estimateGarmentLanding() at save time (a LandingEstimate),
  // same reasoning as verdict being a snapshot: the profile it was computed
  // against can change later, and this should keep reflecting what was true
  // when the check actually ran.
  landing       Json?
  confirmed     Boolean  @default(false)
  actualFit     String?
  // Small downscaled thumbnails (data URLs) for the history list -- not the
  // full-resolution images sent to Gemini, just enough to recognize the item
  // and re-inspect a tape-measure shot at a glance. Capped client-side.
  images        Json?
  createdAt     DateTime @default(now())

  @@index([profileId])
}
