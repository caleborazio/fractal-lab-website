generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id                  String     @id // Clerk user id ("dev-user" in dev-bypass mode)
  bust                Float
  waist               Float
  hip                 Float
  height              Float?
  plan                String     @default("free") // "free" | "paid"
  // Rolling usage counter for the free tier -- checksUsedThisMonth only
  // means what it says while usageMonth matches the current "YYYY-MM";
  // otherwise it's stale from a prior month and reads as 0 (see lib/usage.ts).
  checksUsedThisMonth Int        @default(0)
  usageMonth          String     @default("")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  checks              FitCheck[]
}

model FitCheck {
  id            String   @id @default(cuid())
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id])
  brand         String?
  garmentType   String   @default("dress")
  sourceUrl     String?
  bust          Float?
  waist         Float?
  hip           Float?
  length        Float?
  rawExtraction Json?
  verdict       Json?
  confirmed     Boolean  @default(false)
  actualFit     String?
  createdAt     DateTime @default(now())

  @@index([profileId])
}
